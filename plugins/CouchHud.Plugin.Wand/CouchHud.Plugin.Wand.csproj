<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>CouchHud plugin for Wand (formerly WeMod): cheats and mods for the running game.</Description>
    <!-- Plugins load from plugins/<folder>/<folder>.dll; keep the names equal. -->
    <AssemblyName>CouchHud.Plugin.Wand</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK comes from CouchHud itself; don't ship a copy. -->
    <ProjectReference Include="..\..\src\CouchHud.Sdk\CouchHud.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
