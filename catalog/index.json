    {
      "id": "casehud",
      "folder": "CouchHud.Plugin.CaseHud",
      "name": "CaseHUD",
      "type": "plugin",
      "category": "hardware",
      "version": "1.1.0",
      "minCouchHud": "0.7.0",
      "author": "kewe87",
      "description": {
        "de": "Schaltet die LCDs in Lüftern und Pumpen von CaseHUD: Szenen, Helligkeit, Beleuchtung, Automatik",
        "en": "Switch and operate the LCDs in your fans and pumps through CaseHUD: scenes, brightness, lighting, automation"
      },
      "longDescription": {
        "de": "Bedient CaseHUD vom Sofa aus: Szenen und Stile wählen, Helligkeit, Modus und Farbschema jedes Displays, Beleuchtung, Automatik und Szenenwechsel ein- und ausschalten, Displays finden. Designs, Effekte und Geräte stellst du in CaseHUD am PC ein (\"Am PC öffnen\"). Das Plugin spricht nur mit CaseHUD auf diesem PC; für die erste Installation lädt es die signierte Version von GitHub, das Aktualisieren erledigt CaseHUD selbst.",
        "en": "Operates CaseHUD from the couch: pick scenes and styles, set the brightness, mode and colour scheme of each display, switch lighting, automation and scene rotation on and off, find the displays. Designs, effects and devices are set up in CaseHUD on the PC (\"Open on the PC\"). The plugin only talks to CaseHUD on this PC; for the first installation it downloads the signed version from GitHub, updating is done by CaseHUD itself."
      },
      "license": "GPL-3.0-only",
      "capabilities": [
        "pages",
        "quickActions",
        "downloads",
        "setup.run",
        "lock.restrict",
        "startup.args",
        "process",
        "registry",
        "native",
        "network:loopback",
        "network:internet",
        "sensors.publish"
      ],
      "suggestWhen": {
        "uninstallEntry": "CaseHUD"
      },
      "icon": "https://raw.githubusercontent.com/kewe87/CouchHUD-Catalog/main/icons/casehud.png",
      "download": "https://github.com/kewe87/CouchHUD-Catalog/releases/download/casehud-1.1.0/CouchHud.Plugin.CaseHud-1.1.0.zip",
      "sdk": 3,
      "sha256": "2142ffa5996c9c67096db4b35456751bf8aef7dd6e35a409477568f71fba5e5b",
      "statement": "",
      "signature": "F6IDZ9k9XP6tDGnt74idOYE8KaCKHBP4IR/+17x4ecXQKaALJr7lLQMyWQ0FYJuC0ijp501YWqQQ6EGIy8bW/A=="
    },
    {
      "id": "vpn",
      "folder": "CouchHud.Plugin.Vpn",
      "name": "VPN",
      "type": "plugin",
      "category": "other",
      "version": "1.0.1",
      "minCouchHud": "0.6.0",
      "author": "kewe87",
      "description": {
        "de": "Schaltet das VPN vom Sofa aus: Status sehen, verbinden, trennen und ein Land wählen (NordVPN), mit Einträgen im Guide-Menü",
        "en": "Switch the VPN from the couch: see the status, connect, disconnect and choose a country (NordVPN), with guide menu entries"
      },
      "longDescription": {
        "de": "Bedient die auf dem PC installierte NordVPN-App vom Sofa aus: Status sehen, Schnellverbindung, mit einem Land aus der Liste verbinden, trennen, dazu ein Eintrag im Guide-Menü. Das Plugin ist kein VPN-Client und kennt keine Zugangsdaten; angemeldet wird nur in der NordVPN-App. Es fragt keinen Dienst nach deiner Adresse: der Status kommt vom VPN-Adapter dieses PCs, und die App wird nur aus dem Programme-Ordner gestartet.",
        "en": "Operates the NordVPN app installed on the PC from the couch: see the status, quick connect, connect to a country from the list, disconnect, with an entry in the guide menu. The plugin is no VPN client and knows no credentials; signing in only works in the NordVPN app. It asks no service for your address: the status comes from this PC's VPN adapter, and the app is only started from the Program Files folder."
      },
      "license": "GPL-3.0-only",
      "capabilities": [
        "pages",
        "quickActions",
        "process",
        "registry",
        "native"
      ],
      "suggestWhen": {
        "uninstallEntry": "NordVPN"
      },
      "icon": "https://raw.githubusercontent.com/kewe87/CouchHUD-Catalog/main/icons/vpn.png",
      "download": "https://github.com/kewe87/CouchHUD-Catalog/releases/download/vpn-1.0.1/CouchHud.Plugin.Vpn-1.0.1.zip",
      "sdk": 3,
      "sha256": "be44443b72bb61eadded761d3d65b645bfb76bf1aa46fa4398e4943ddf3150b9",
      "statement": "",
      "signature": "4fRg9bKGnxciP0DUCdsv81VNnRnr14yRCDKTbR/zZOYHkaPHJRYp4Z6RN5C6dGGWAPLIao2REAhqx5rsD0XbjA=="
    },
